# Salin menjadi .env (docker compose otomatis membacanya). Semua opsional.

# --- Port ---
FRONTEND_PORT=3000
BACKEND_PORT=8000

# --- Upload & storage ---
MAX_UPLOAD_MB=4096
MIN_FREE_DISK_MB=1024
# Hasil TIDAK disimpan permanen. Semua file dihapus otomatis agar storage tidak membengkak:
JOB_RETENTION_MINUTES=20    # video+caption hasil dihapus N menit setelah selesai (diperpanjang selama diputar/diunduh)
UPLOAD_RETENTION_MINUTES=120  # video sumber dihapus N menit setelah terakhir dipakai; 0 = langsung dihapus setelah clip jadi
CLEAN_ON_START=false        # R&D: jangan hapus upload/job lama saat server dinyalakan

# --- Rendering (profil eksperimen R&D: lebih cepat; CRF/FPS tetap) ---
MAX_CONCURRENT_JOBS=1       # jumlah render paralel (FFmpeg sudah multi-thread, 1 disarankan)
MAX_CLIP_SECONDS=600
OUTPUT_FPS=30
VIDEO_CRF=14                # kualitas sangat tinggi; angka lebih kecil = lebih tajam, file lebih besar
VIDEO_PRESET=medium
AUDIO_BITRATE=192k
KEEP_INTERMEDIATE=false     # true = simpan template.png/episode.png/title.png di storage/jobs/<id>/

# --- Caption otomatis (caption.txt) ---
# Caption dibuat oleh AI vision dari frame video + judul + arc + catatan.
# Isi SALAH SATU key. Tanpa key, aplikasi tetap jalan dan hanya membuat caption dasar (judul + hashtag).
OPENAI_API_KEY=
OPENAI_CAPTION_MODEL=gpt-4o-mini      # harus model yang mendukung gambar, mis. gpt-4o-mini / gpt-4o
ANTHROPIC_API_KEY=
CAPTION_MODEL=claude-sonnet-5
CAPTION_PROVIDER=auto                 # auto | openai | anthropic  (auto = pakai yang key-nya terisi)
CAPTION_FRAMES=6                      # jumlah frame yang dikirim ke AI (1-10); bisa diubah per-clip lewat pilihan "Hemat" di form
CAPTION_DEFAULT_ON=true               # status awal toggle caption di web (pilihan terakhir user diingat browser)

# --- Lainnya ---
LOG_LEVEL=INFO
# Hanya untuk run lokal (tanpa Docker):
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
# CORS_ORIGINS=http://localhost:5173
# FILENAME_TITLE_WORDS=2
# TITLE_MAX_CHARS=200
